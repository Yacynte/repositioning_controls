# Ignore virtual environment directories
.venv

# Ignore everything inside the data directory by default
data/

# But keep the evaluation results. Git cannot re-include a file inside an ignored folder, so every
# parent folder is re-included and then its other contents ignored again, one level at a time.

# --- finalMotion (raw simulation + drone data, not versioned): keep only the results document,
# summaries, summary figures and the drone figures
finalMotion/
# !finalMotion/RESULTS.md
# !finalMotion/analysis/
# finalMotion/analysis/*
# !finalMotion/analysis/results.json
# !finalMotion/analysis/summary.md
# !finalMotion/analysis/summary.csv
# !finalMotion/analysis/trials.csv
# !finalMotion/analysis/drone_runs.csv
# !finalMotion/analysis/image_scores.json
# !finalMotion/analysis/figures/
# !finalMotion/analysis/drone/

# --- finalMotion: GT4 example (target image + pose, base-set per-trial figures)
# !finalMotion/GroundTruth/
# finalMotion/GroundTruth/*
# !finalMotion/GroundTruth/GT4_*/
# finalMotion/GroundTruth/GT4_*/*
# !finalMotion/GroundTruth/GT4_*/rgb.png
# !finalMotion/GroundTruth/GT4_*/meta.json
# !finalMotion/analysis/trials/
# finalMotion/analysis/trials/*
# !finalMotion/analysis/trials/5_05/
# finalMotion/analysis/trials/5_05/*
# !finalMotion/analysis/trials/5_05/GT4_*

# --- motionLog5_03: results document, summaries, summary figures, GT4 per-trial figures
# !data/motionLog5_03/
# data/motionLog5_03/*
# !data/motionLog5_03/RESULTS1.md
# !data/motionLog5_03/analysis1/
# data/motionLog5_03/analysis1/*
# !data/motionLog5_03/analysis1/results.json
# !data/motionLog5_03/analysis1/summary.md
# !data/motionLog5_03/analysis1/summary.csv
# !data/motionLog5_03/analysis1/trials.csv
# !data/motionLog5_03/analysis1/figures/
# !data/motionLog5_03/analysis1/trials/
# data/motionLog5_03/analysis1/trials/*
# !data/motionLog5_03/analysis1/trials/5_03_sunny/
# data/motionLog5_03/analysis1/trials/5_03_sunny/*
# !data/motionLog5_03/analysis1/trials/5_03_sunny/GT4_*

# Ignore logs completely (also covers run folders like /logData5_05fog)
/log*
/finalMotion.7z
/analysis.7z
# Python bytecode
__pycache__/
*.pyc
